{
  "name": "mosaikit-plugins",
  "private": true,
  "description": "UIs of the official plugins of Mosaikit (npm workspaces)",
  "workspaces": [
    "notes/ui",
    "tasks/ui",
    "chat/ui",
    "announcements/ui",
    "bookmarks/ui",
    "snippets/ui",
    "polls/ui",
    "surveys/ui",
    "approvals/ui",
    "dashboard/ui",
    "forms/ui",
    "projects/ui",
    "calendar/ui",
    "whiteboard/ui",
    "meet/ui",
    "contacts/ui",
    "maps/ui",
    "static-site/ui",
    "files/ui",
    "note-review/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint . --deny-warnings"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mosaikit/plugin-api": "file:../mosaikit/ui/plugin-api",
    "@tanstack/virtual-core": "^3.19.12",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
